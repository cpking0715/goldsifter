#!/bin/bash
# Wrapper: allowlisted `ls` invoked with PATH pointing here → forward to git.
# Shell aliases may inject ls flags (-F, --show-control-chars, etc.); drop them.
start=0
i=1
for a in "$@"; do
  case "$a" in
    log|diff|show|status|rev-parse|merge-base|ls-files|ls-tree|cat-file|blame|grep|shortlog|describe|tag|branch|remote|stash|config|help|version)
      start=$i
      break
      ;;
  esac
  i=$((i+1))
done
if [ "$start" -eq 0 ]; then
  echo "ls-git wrapper: no git subcommand found in: $*" >&2
  exit 2
fi
shift $((start-1))
exec /cmd/git.exe "$@"
